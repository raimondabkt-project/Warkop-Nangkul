<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nangkul Market</title>
    <link rel="shortcut icon" href="img/favicon2.png" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Londrina+Solid:wght@100;300&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/style.css">
</head>

<body>
    <Header>
        <div class="fContainer">
            <nav class="wrepper">
                <div>
                    <img src="img/NANGKUL-MARKET-unscreen.gif" alt="" class="logo">
                </div>

                <div>
                    <ul class="navigation">
                        <li>Kategori</li>
                        <li>
                            <form class="form">
                                <button>
                                    <svg width="17" height="16" fill="none" xmlns="http://www.w3.org/2000/svg"
                                        role="img" aria-labelledby="search">
                                        <path
                                            d="M7.667 12.667A5.333 5.333 0 107.667 2a5.333 5.333 0 000 10.667zM14.334 14l-2.9-2.9"
                                            stroke="currentColor" stroke-width="1.333" stroke-linecap="round"
                                            stroke-linejoin="round"></path>
                                    </svg>
                                </button>
                                <input class="input" placeholder="Cari di Nangkul" required="" type="text">
                                <button class="reset" type="reset">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none"
                                        viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12">
                                        </path>
                                    </svg>
                                </button>
                            </form>
                        </li>
                        <li class="shop-logo"><a href="/shopCard" target="_blank"><img src="img/shopping-cart.png"></a>
                        </li>

                       

                        <div class="dropdown">
                            <button class="dropbtn"><%=user.username %>
                              <i class="fa fa-caret-down"></i>
                            </button>
                            <div class="dropdown-content">
                              <a href="/" target="_self">Logout</a>
                            </div>
                          </div> 

                    </ul>
                </div>
            </nav>
        </div>
    </Header>
    <main>
        <div class="list">
            <div class="item">
                <img src="img/kopi susu.jpg">
                <div class="title">Kopi Susu</div>
                <div class="price">Rp.15.000</div>
                <button onclick="addToCard(0)">Add To Card</button>
            </div>
            <div class="item">
                <img src="img/cappucino.jpg">
                <div class="title">Cappucino Susu</div>
                <div class="price">Rp.10.000</div>
                <button onclick="addToCard(1)">Add To Card</button>
            </div>
            <div class="item">
                <img src="img/mandi.jpg">
                <div class="title">Teh Manis Dingin</div>
                <div class="price">Rp.13.000</div>
                <button onclick="addToCard(2)">Add To Card</button>
            </div>
            <div class="item">
                <img src="img/teh serai.jpg">
                <div class="title">Teh Sereh</div>
                <div class="price">Rp.10.000</div>
                <button onclick="addToCard(3)">Add To Card</button>
            </div>
            <div class="item">
                <img src="img/tst.jpg">
                <div class="title">Teh Susu Telur</div>
                <div class="price">Rp.12.000</div>
                <button onclick="addToCard(4)">Add To Card</button>
            </div>
            <div class="item">
                <img src="img/jus1.jpg">
                <div class="title">Jus Jeruk</div>
                <div class="price">Rp.13.000</div>
                <button onclick="addToCard(5)">Add To Card</button>
            </div>
        </div>
        </div>

        <div class="list2">

            <div class="item">
                <img src="img/buah potong.jpg">
                <div class="title">Buah Potong</div>
                <div class="price">Rp.15.000</div>
                <button onclick="addToCard(0)">Add To Card</button>
            </div>
            <div class="item">
                <img src="img/mi sop.jpg">
                <div class="title">Mie Sop</div>
                <div class="price">Rp.10.000</div>
                <button onclick="addToCard(1)">Add To Card</button>
            </div>
            <div class="item">
                <img src="img/nasgor.jpg">
                <div class="title">Nasi Goreng</div>
                <div class="price">Rp.13.000</div>
                <button onclick="addToCard(2)">Add To Card</button>
            </div>
            <div class="item">
                <img src="img/nastel.jpg">
                <div class="title">Nastel</div>
                <div class="price">Rp.10.000</div>
                <button onclick="addToCard(3)">Add To Card</button>
            </div>
            <div class="item">
                <img src="img/mie goreng.jpg">
                <div class="title">Mie Goreng</div>
                <div class="price">Rp.12.000</div>
                <button onclick="addToCard(4)">Add To Card</button>
            </div>
            <div class="item">
                <img src="img/ayam geprek1.jpg">
                <div class="title">Ayam Geprek</div>
                <div class="price">Rp.13.000</div>
                <button onclick="addToCard(5)">Add To Card</button>
            </div>
        </div>
        </div>
    </main>

    <footer>
        <p>Copyright 2023-2026 by Nangkul Teams. All Right Reserved</p>
    </footer>

    <script src="js/main.js"></script>
</body>

</html>